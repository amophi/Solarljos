<!--
  What a card of what is searched has that no other part has (details.notes in style.css): the
  notes that open under a short link ("What it sees here", in the accent, with an arrow that
  points on and turns down once they are open), on the raised colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:u="clr-namespace:Solarljos.Ui">

  <Style x:Key="NotesHeader" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" MinHeight="36" Padding="8,0,12,0">
            <StackPanel Orientation="Horizontal">
              <u:Icon x:Name="Chevron" Glyph="chevron" Width="16" Height="16" Foreground="{TemplateBinding Foreground}"
                      VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                <u:Icon.RenderTransform>
                  <RotateTransform Angle="0" />
                </u:Icon.RenderTransform>
              </u:Icon>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- details.notes: the link above, and what it holds below it, on the raised colour. -->
  <Style x:Key="NotesExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Margin" Value="-8,4,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Style="{StaticResource NotesHeader}" Content="{TemplateBinding Header}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          AutomationProperties.Name="{TemplateBinding Header}" />
            <Border x:Name="Body" Visibility="Collapsed" Background="{DynamicResource Raised}" CornerRadius="10"
                    Padding="14,10" Margin="8,4,0,4">
              <ContentPresenter />
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
