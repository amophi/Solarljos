<!--
  The tree of a folder's plan, as the page draws its role=tree (src/gui/ui/style.css, "folder
  plan"): on the cards' colour with round corners, each row 40 pixels high at least, indented 24
  pixels a level, where the mouse is a little lighter, and, where the keyboard is, a 2-pixel ring
  in the accent inside the row. A folder's rows are below its own, each across the whole width.
  It has no scroller of its own: it scrolls with the page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:f="clr-namespace:Solarljos.Views.Folder">

  <Style TargetType="{x:Type f:PlanTree}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type f:PlanTree}">
          <Border Background="{DynamicResource Card}" CornerRadius="20" Padding="8" SnapsToDevicePixels="True">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type f:PlanTreeItem}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type f:PlanTreeItem}">
          <StackPanel>
            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10"
                    MinHeight="40" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="False" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
            <Trigger Property="Ring" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
