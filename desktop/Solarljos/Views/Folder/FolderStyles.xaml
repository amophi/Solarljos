<!--
  The tree of a folder's plan, as the page draws its role=tree (src/gui/ui/style.css, "folder
  plan"): on the cards' colour with round corners, each row 40 pixels high at least, indented 24
  pixels a level, where the mouse is a little lighter, and, where the keyboard is, a 2-pixel ring
  in the accent inside the row. A folder's rows are below its own, each across the whole width.
  Unlike the page's, it scrolls on its own: only the rows in sight are made, by a virtualizing
  panel for the tree and one for each folder in it, which needs a scroller around them, and the
  row's own part named PART_Header, for the panels to know how tall it is. And the day of the
  form with its calendar, as Find a file draws it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:f="clr-namespace:Solarljos.Views.Folder">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Solarljos;component/Views/Find/FindStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <ItemsPanelTemplate x:Key="PlanRows">
    <VirtualizingStackPanel />
  </ItemsPanelTemplate>

  <Style TargetType="{x:Type f:PlanTree}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="ItemsPanel" Value="{StaticResource PlanRows}" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type f:PlanTree}">
          <Border Background="{DynamicResource Card}" CornerRadius="20" Padding="8" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="_tv_scrollviewer_" Focusable="False" CanContentScroll="True"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter x:Name="Rows" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type f:PlanTreeItem}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ItemsPanel" Value="{StaticResource PlanRows}" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type f:PlanTreeItem}">
          <StackPanel>
            <Border x:Name="PART_Header" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10"
                    MinHeight="40" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="False" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Header" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
            <Trigger Property="Ring" Value="True">
              <Setter TargetName="PART_Header" Property="BorderBrush" Value="{DynamicResource Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
