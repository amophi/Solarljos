  <SolidColorBrush x:Key="AccentText" Color="#64A8FF" />
  <SolidColorBrush x:Key="AccentSoft" Color="#293182F6" />
  <SolidColorBrush x:Key="OnFill" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Danger" Color="#E53935" />
  <SolidColorBrush x:Key="DangerFill" Color="#D32F2F" />
  <SolidColorBrush x:Key="DangerFillHover" Color="#C62828" />
  <SolidColorBrush x:Key="DangerText" Color="#FF7A73" />
  <SolidColorBrush x:Key="Warning" Color="#FFB74D" />
  <SolidColorBrush x:Key="Success" Color="#5BC37A" />

  <SolidColorBrush x:Key="Field" Color="#2A2C31" />
