<!--
  The dark theme, SoundVisualizer's colours as the page has them (src/gui/ui/style.css, whose
  top says what each was measured against): every text colour at 4.5:1 or more on what it is
  shown on, every mark of a control's place and state at 3:1. Translucent ones as #AARRGGBB.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#2A2C31" />
  <SolidColorBrush x:Key="Card" Color="#1E2024" />
  <SolidColorBrush x:Key="CardHover" Color="#25282D" />
  <SolidColorBrush x:Key="Raised" Color="#25282D" />
  <SolidColorBrush x:Key="Track" Color="#333A44" />
  <SolidColorBrush x:Key="TrackHover" Color="#3B4350" />
  <SolidColorBrush x:Key="TrackPress" Color="#2E343D" />
  <SolidColorBrush x:Key="Hover" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="Press" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="Divider" Color="#14FFFFFF" />

  <SolidColorBrush x:Key="Text" Color="#F2F4F6" />
  <SolidColorBrush x:Key="Text2" Color="#8B95A1" />
  <SolidColorBrush x:Key="TextOnTrack" Color="#B0B8C1" />
  <SolidColorBrush x:Key="TextDisabled" Color="#6B7684" />
  <SolidColorBrush x:Key="TabHover" Color="#C5CCD4" />

  <SolidColorBrush x:Key="Accent" Color="#3182F6" />
