{
  "name": "solarljos",
  "version": "0.7.0",
  "description": "Finds files you have lost, deleted or saved over, in the copies Windows and your programs keep on their own, and brings back the ones you choose into a folder you choose, changing nothing else on the computer.",
  "license": "MIT",
  "author": "amophi",
  "homepage": "https://github.com/amophi/Solarljos#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/amophi/Solarljos.git"
  },
  "bugs": {
    "url": "https://github.com/amophi/Solarljos/issues"
  },
  "keywords": [
    "recover",
    "undelete",
    "deleted files",
    "file recovery",
    "data recovery",
    "recycle bin",
    "shadow copy",
    "restore point",
    "local history",
    "jetbrains",
    "android studio",
    "notepad",
    "hancom",
    "claude code",
    "antigravity",
    "git",
    "trash",
    "photo recovery",
    "video recovery",
    "thumbnail cache",
    "thumbcache",
    "snipping tool",
    "sd card",
    "usb stick",
    "fat32",
    "exfat",
    "file carving",
    "windows",
    "portable",
    "gui",
    "i18n",
    "multilingual"
  ],
  "main": "src/index.js",
  "bin": {
    "solarljos": "bin/solarljos.js"
  },
  "files": [
    "bin",
    "docs",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "bundle": "node scripts/bundle.js",
    "build:exe": "node scripts/build-exe.js",
    "i18n": "node scripts/i18n.js"
  }
}
